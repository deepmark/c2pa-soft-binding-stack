# Copy to `.env` and tweak as needed. docker-compose reads it
# automatically on `docker compose up`.

# ---- Host port bindings ----------------------------------------------------
RESOLUTION_API_PORT=8000
INGESTION_API_PORT=8001
VIGIL_128_PORT=8101
MONGO_PORT=27017

# ---- Ingest pipeline -------------------------------------------------------
DEFAULT_AUDIO_ALG=me.deepmark.audio.vigil.128

# Signing alg used for the C2PA manifest. Supported:
#   ES256, ES384, ES512, PS256, PS384, PS512, ED25519
SIGNING_ALG=ES256

# Optional RFC 3161 timestamp authority. Empty = no TSA.
TA_URL=

# ---- Required paths (ingestion-api, only when running outside compose) ----
# docker-compose sets these automatically. Uncomment + set if running
# ingestion-api directly from a checkout.
# ALGORITHMS_CATALOG_PATH=/absolute/path/to/algorithms.yaml
# CREDENTIALS_DIR=/absolute/path/to/credentials
# STORAGE_ROOT=/absolute/path/to/storage

# ---- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
