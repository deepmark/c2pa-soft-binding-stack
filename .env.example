# Copy to `.env` and tweak as needed. docker-compose reads it
# automatically on `docker compose up`.

# ---- Host port bindings ----------------------------------------------------
RESOLUTION_API_PORT=8000
INGESTION_API_PORT=8001
VIGIL_128_PORT=8101
MONGO_PORT=27017

# ---- Ingest pipeline -------------------------------------------------------
# Signing alg used for the C2PA manifest. Supported:
#   ES256, ES384, ES512, PS256, PS384, PS512, ED25519
SIGNING_ALG=ES256

# Optional RFC 3161 timestamp authority. Empty = no TSA.
TA_URL=

# Auto-push every ingest to the resolution-api so it's queryable via
# /matches/byBinding. Defaults to true. Set to false ONLY for genuine
# standalone deployments (signing pipelines that don't feed a resolver
# — records will not be queryable).
RESOLUTION_PUSH_ENABLED=true
# When push enabled, RESOLUTION_API_URL is required (compose default
# below resolves to the in-stack service). Override here only for
# external resolution-api instances or push-disabled deployments.
# RESOLUTION_API_URL=http://resolution-api:8000

# Per-call retry policy for the auto-push. Each HTTP request retries
# up to N times on transient failure (5xx, timeout, network); 4xx is
# permanent. Backoff doubles each retry starting at the value below.
# RESOLUTION_MAX_RETRIES=1
# RESOLUTION_RETRY_BACKOFF_S=0.5

# ---- Required ingestion-api settings (only when running outside compose) --
# docker-compose sets these automatically. Uncomment + set if running
# ingestion-api directly from a checkout. By default both services use
# the same Mongo database and separate collections inside it.
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_DATABASE=c2pa
# CREDENTIALS_DIR=/absolute/path/to/credentials
# STORAGE_ROOT=/absolute/path/to/storage

# ---- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
