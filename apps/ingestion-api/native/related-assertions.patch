-    // Convert a Manifest into a Claim
+    /// Resolve the Builder-only `parameters.relatedAssertionLabels` input to
+    /// actual hashed references before the actions assertion is serialized.
+    /// Labels are the final assertion labels, including duplicate suffixes.
+    fn resolve_related_assertion_labels(
+        action: &mut Action,
+        assertion_map: &HashMap<String, HashedUri>,
+    ) -> Result<()> {
+        let Some(value) = action.remove_parameter("relatedAssertionLabels") else {
+            return Ok(());
+        };
+        let related_labels: Vec<String> = c2pa_cbor::value::from_value(value).map_err(|_| {
+            Error::BadParam(
+                "relatedAssertionLabels must be an array of assertion labels".to_string(),
+            )
+        })?;
+        if related_labels.is_empty() {
+            return Err(Error::BadParam(
+                "relatedAssertionLabels must not be empty".to_string(),
+            ));
+        }
+        let mut seen = HashSet::new();
+        let mut related_uris = Vec::with_capacity(related_labels.len());
+        for label in related_labels {
+            if label.is_empty() || !seen.insert(label.clone()) {
+                return Err(Error::BadParam(format!(
+                    "relatedAssertionLabels contains an empty or duplicate label: {label}"
+                )));
+            }
+            // Ingredient/action relationships use other fields; hard bindings
+            // can change later during signing and are not stable targets here.
+            let base_label = parse_label(&label).0;
+            if base_label.starts_with(Actions::LABEL)
+                || base_label.starts_with(labels::INGREDIENT)
+                || labels::HASH_LABELS.contains(&base_label)
+            {
+                return Err(Error::BadParam(format!(
+                    "Unsupported relatedAssertionLabels target: {label}"
+                )));
+            }
+            related_uris.push(assertion_map.get(&label).cloned().ok_or_else(|| {
+                Error::BadParam(format!("relatedAssertionLabels target not found: {label}"))
+            })?);
+        }
+        // Preserve supplied hashed references. Set the typed field rather than
+        // adding a common parameter with the same serialized name.
+        action
+            .parameters
+            .get_or_insert_default()
+            .related_assertions
+            .get_or_insert_default()
+            .extend(related_uris);
+        Ok(())
+    }
