+    #[test]
+    fn test_related_assertion_labels_reject_invalid_targets() -> Result<()> {
+        for labels in [
+            json!([]),
+            json!([""]),
+            json!(["c2pa.soft-binding", "c2pa.soft-binding"]),
+            json!(["c2pa.soft-binding__10"]),
+            json!(["c2pa.actions.v2"]),
+            json!(["c2pa.ingredient.v3"]),
+            json!(["c2pa.hash.data"]),
+            json!([42]),
+            json!(null),
+            json!("c2pa.soft-binding"),
+        ] {
+            let builder = Builder::from_context(test_context()).with_definition(json!({
+                "assertions": [
+                    {"label": "c2pa.actions.v2", "created": true, "data": {"actions": [
+                        {"action": "c2pa.watermarked.bound", "parameters": {"relatedAssertionLabels": labels}}
+                    ]}},
+                    {"label": "c2pa.soft-binding", "data": {"alg": "org.test.watermark"}}
+                ]
+            }).to_string())?;
+            assert!(
+                matches!(builder.to_claim(), Err(Error::BadParam(_))),
+                "accepted invalid labels: {labels}"
+            );
+        }
+        Ok(())
+    }
+
+    #[test]
+    fn test_related_assertion_labels_preserve_existing_hashed_references() -> Result<()> {
+        let mut claim = Claim::new("test", None, 2).with_context(test_context().into_shared());
+        let first = claim.add_assertion(&User::new("org.test.first", r#"{"value":1}"#))?;
+        let second = claim.add_assertion(&User::new("org.test.second", r#"{"value":2}"#))?;
+        let mut action: Action = serde_json::from_value(json!({
+            "action": "c2pa.watermarked.bound", "parameters": {
+                "relatedAssertions": [first], "relatedAssertionLabels": ["org.test.second"]
+            }
+        }))?;
+        let mut assertion_map = HashMap::new();
+        assertion_map.insert("org.test.second".to_string(), second.clone());
+        Builder::resolve_related_assertion_labels(&mut action, &assertion_map)?;
+        let refs = action.related_assertions().unwrap();
+        assert_eq!(refs.len(), 2);
+        assert_eq!(refs[0].url(), first.url());
+        assert_eq!(refs[0].hash(), first.hash());
+        assert_eq!(refs[1].url(), second.url());
+        assert_eq!(refs[1].hash(), second.hash());
+        assert!(action
+            .get_parameter::<Vec<String>>("relatedAssertionLabels")
+            .is_none());
+        assert!(!action
+            .parameters()
+            .unwrap()
+            .common
+            .contains_key("relatedAssertions"));
+        Ok(())
+    }
+
+    #[test]
+    fn test_related_assertion_labels_do_not_change_existing_only_action() -> Result<()> {
+        let mut claim = Claim::new("test", None, 2).with_context(test_context().into_shared());
+        let uri = claim.add_assertion(&User::new("org.test.first", r#"{"value":1}"#))?;
+        let mut action: Action = serde_json::from_value(json!({
+            "action": "c2pa.watermarked.bound", "parameters": {"relatedAssertions": [uri]}
+        }))?;
+        let original = serde_json::to_value(&action)?;
+        Builder::resolve_related_assertion_labels(&mut action, &HashMap::new())?;
+        assert_eq!(serde_json::to_value(&action)?, original);
+        Ok(())
+    }
