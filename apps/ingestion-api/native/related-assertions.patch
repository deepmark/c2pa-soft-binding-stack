+    #[test]
+    fn test_related_assertion_labels_resolve_final_hashes() -> Result<()> {
+        let builder = Builder::from_context(test_context()).with_definition(
+            json!({
+                "assertions": [
+                    {
+                        "label": "c2pa.actions.v2", "created": true,
+                        "data": {"actions": [
+                            {"action": "c2pa.created", "digitalSourceType": "http://c2pa.org/digitalsourcetype/empty"},
+                            {"action": "c2pa.watermarked.bound", "parameters": {
+                                "relatedAssertionLabels": ["c2pa.soft-binding__1", "c2pa.soft-binding__2"]
+                            }}
+                        ]}
+                    },
+                    {"label": "c2pa.soft-binding", "data": {"alg": "org.test.fingerprint", "blocks": [{"scope": {}, "value": "fp"}]}},
+                    {"label": "c2pa.soft-binding", "data": {"alg": "org.test.watermark", "blocks": [{"scope": {}, "value": "wm1"}]}},
+                    {"label": "c2pa.soft-binding", "data": {"alg": "org.test.watermark", "blocks": [{"scope": {}, "value": "wm2"}]}},
+                    {"label": "c2pa.actions.v2", "data": {"actions": [{"action": "c2pa.color_adjustments"}]}}
+                ]
+            }).to_string(),
+        )?;
+        let claim = builder.to_claim()?;
+        assert_eq!(claim.created_action_assertions().len(), 1);
+        assert_eq!(claim.gathered_action_assertions().len(), 1);
+        let actions = Actions::from_assertion(claim.created_action_assertions()[0].assertion())?;
+        assert_eq!(actions.actions()[0].action(), c2pa_action::CREATED);
+        let action = actions
+            .actions()
+            .iter()
+            .find(|a| a.action() == "c2pa.watermarked.bound")
+            .unwrap();
+        assert!(action
+            .get_parameter::<Vec<String>>("relatedAssertionLabels")
+            .is_none());
+        let references = action.related_assertions().unwrap();
+        assert_eq!(references.len(), 2);
+        for (reference, label) in references
+            .iter()
+            .zip(["c2pa.soft-binding__1", "c2pa.soft-binding__2"])
+        {
+            assert_eq!(
+                reference.url(),
+                format!("self#jumbf=c2pa.assertions/{label}")
+            );
+            let target = claim
+                .claim_assertion_store()
+                .iter()
+                .find(|a| a.label() == label)
+                .unwrap();
+            assert_eq!(reference.hash(), target.hash());
+            // This recomputes the serialized assertion-box digest, including its
+            // final label and actual salt, rather than checking a nonempty hash.
+            let recomputed = Claim::calc_assertion_box_hash(
+                label,
+                target.assertion(),
+                target.salt().clone(),
+                claim.alg(),
+            )?;
+            assert_eq!(reference.hash(), recomputed);
+        }
+        assert_ne!(references[0].hash(), references[1].hash());
+        let gathered = Actions::from_assertion(claim.gathered_action_assertions()[0].assertion())?;
+        assert_eq!(gathered.actions()[0].action(), "c2pa.color_adjustments");
+        Ok(())
+    }
